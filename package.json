{
  "name": "qbit-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun run lint && bun run format && bun run typecheck && bun run test && bun run e2e",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:snapshots": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.5.1",
    "@unocss/reset": "66.10.2",
    "@unocss/transformer-directives": "66.10.2",
    "@vitejs/plugin-vue": "6.0.8",
    "happy-dom": "20.14.5",
    "lefthook": "2.1.12",
    "typescript": "6.0.3",
    "unocss": "66.10.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@dannymichel/proxima-nova": "4.5.2",
    "merge": "2.1.1",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "wretch": "3.0.9"
  }
}
